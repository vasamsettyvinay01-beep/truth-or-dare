# ---------------------------------------------------------------------------
# Truth or Dare — environment variables
#
# Copy to `.env.local` for local development. Never commit real values.
# The frontend (Next.js) and the realtime server are deployed separately:
# Vercel cannot host a long-lived Socket.IO connection, so the server needs a
# persistent Node host such as Render, Railway or Fly.
# ---------------------------------------------------------------------------

# --- Realtime server (server/) ---------------------------------------------

# Port the Socket.IO/Express server listens on. Most hosts inject this.
PORT=4001

# Primary browser origin allowed to connect.
CLIENT_ORIGIN=http://localhost:3000

# Comma-separated allowlist used for CORS. Supports a single-label wildcard so
# Vercel preview deployments keep working, e.g. https://*.vercel.app
# Leave unset to fall back to CLIENT_ORIGIN.
CLIENT_ORIGINS=http://localhost:3000

# --- Web client (web/) ------------------------------------------------------

# Public URL of the realtime server. This is baked into the browser bundle at
# build time, so it must be reachable from a phone on mobile data — never
# localhost, and it must be https:// in production or the browser will block
# the connection as mixed content.
#   local dev:   http://localhost:4001
#   production:  https://truth-or-dare-api.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
