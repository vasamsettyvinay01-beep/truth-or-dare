# ---------------------------------------------------------------------------
# Truth or Dare — environment variables (placeholders only)
#
# Copy values into web/.env.local and/or your host's dashboard.
# Never commit real tokens or secrets.
# ---------------------------------------------------------------------------

# --- Realtime server (server/) ---------------------------------------------

PORT=4001
NODE_ENV=development

# Primary browser origin allowed to connect (credentials enabled).
CLIENT_ORIGIN=http://localhost:3000

# Comma-separated CORS allowlist. Prefer exact origins in production.
# Single-label wildcards are supported, e.g.:
#   https://truth-or-dare-*-vasamsettyvinay01-beeps-projects.vercel.app
# Do NOT set "*" in production.
CLIENT_ORIGINS=http://localhost:3000

# --- Web client (web/) ------------------------------------------------------

# Public https URL of the Socket.IO server (inlined at Next.js build time).
# Local:  http://localhost:4001
# Prod:   https://YOUR-API-HOST.up.railway.app
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
